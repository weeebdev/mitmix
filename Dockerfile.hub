FROM node:22-alpine AS svelte-build
WORKDIR /src
COPY internal/hub/site/package*.json ./
RUN npm ci
COPY internal/hub/site/ ./
RUN npm run build

FROM golang:latest AS go-build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=svelte-build /src/dist /src/internal/hub/site/dist
RUN CGO_ENABLED=0 go build -o /out/mitm-hub .

FROM alpine:3.21
WORKDIR /app
COPY --from=go-build /out/mitm-hub /app/mitm-hub
EXPOSE 8090
VOLUME /pb_data
ENTRYPOINT ["/app/mitm-hub", "serve"]
